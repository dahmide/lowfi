{
    "name": "server",
    "main": "app.js",
    "type": "module",
    "scripts": {
        "dev": "NODE_ENV=development tsx watch src/app.ts",
        "build": "tsc",
        "start": "NODE_ENV=production node dist/app.js",
        "db:seed": "tsx src/db/seed.ts",
        "db:push": "drizzle-kit push",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "generate:azuracast": "swagger-typescript-api generate -p https://raw.githubusercontent.com/AzuraCast/AzuraCast/main/web/static/openapi.yml -o ./src/api -n azuracast.ts"
    },
    "packageManager": "yarn@4.9.2",
    "dependencies": {
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "eventsource": "^5.1.1",
        "express": "^5.2.1",
        "ioredis": "^5.11.1",
        "jsonpath-plus": "^10.4.0",
        "node-cron": "^4.6.0",
        "pg": "^8.23.0",
        "socket.io": "^4.8.3"
    },
    "resolutions": {
        "typescript": "5.7.3",
        "esbuild": "^0.25.2"
    },
    "devDependencies": {
        "@types/cors": "^2",
        "@types/eventsource": "^3.0.0",
        "@types/express": "^5.0.6",
        "@types/node": "^26.1.2",
        "@types/node-cron": "^3.0.11",
        "@types/pg": "^8.23.1",
        "drizzle-kit": "^0.31.10",
        "swagger-typescript-api": "^13.12.6",
        "tsx": "^4.23.13",
        "typescript": "5.7.3"
    }
}
