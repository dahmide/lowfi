{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        // "rewriteRelativeImportExtensions": true,
        // "erasableSyntaxOnly": true,
        "moduleResolution": "bundler",
        "outDir": "dist",
        "rootDir": "src",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "verbatimModuleSyntax": false,
        "noEmit": false,
        "strict": true,
        "skipLibCheck": true,
        "lib": ["dom"],
        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"],
            "@shared/*": ["../shared/*"]
        }
    },
    "include": ["src"]
}
